      {"part": "走廊牆面", "material": "水泥牆", "install": "夜燈可用螺絲固定"},
      {"part": "走廊牆面", "material": "磚牆", "install": "夜燈可用螺絲固定"},
      {"part": "大門門框", "material": "鋁框", "install": "門窗感測器改用背膠，不鑽孔"}
