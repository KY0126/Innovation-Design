# AI顧問阿國的金鑰範本：複製成 jiujujia-agent/.env 再填入你自己的值。.env 不要 commit、不要截圖、不要傳到群組。
# Cloudflare 帳號 ID（Workers AI 頁面可以看到，一串 32 個英數字）
CF_ACCOUNT_ID=your_account_id_here
# Cloudflare API Token（要有 Workers AI 權限）。外流的話請到 Cloudflare 後台 Roll 換新。
LLM_API_KEY=your_token_here
# 回答 Agent 與驗證 Agent 用不同家族的模型，避免同樣的盲點（可改成 Cloudflare 上其他模型）
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
VERIFIER_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
# 如果改用其他 OpenAI 相容 API，填這一行（會忽略 CF_ACCOUNT_ID）
# LLM_BASE_URL=https://.../v1
