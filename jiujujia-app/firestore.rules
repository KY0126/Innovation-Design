rules_version = '2';

// 揪居家 Firestore rules — see ARCHITECTURE.md §3–§5. Every rule here needs an allowed and a denied test in tests/rules.
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is closed until its issue defines the rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
