# 複製成 .env.local 並填入 Firebase 主控台「專案設定 → 你的應用程式 → Web App」的 firebaseConfig。
# 這些是前端公開設定，不是密碼；但 .env.local 仍不要 commit。
# 不建立 .env.local（或 NEXT_PUBLIC_FIREBASE_PROJECT_ID 留空）時，程式會自動連到本機模擬器。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 已填真專案但想暫時改用模擬器時，設為 true
NEXT_PUBLIC_USE_EMULATORS=
